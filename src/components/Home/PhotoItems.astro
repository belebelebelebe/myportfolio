---
import { getCollection } from "astro:content";
import CarouselItem from "../CarouselItem.astro";

const LIMIT = 12;

// 1. Fetching from 'posts' or your primary visual collection since 'photos' isn't registered
const entries = await getCollection("posts");
const limitedEntries = entries.slice(0, LIMIT);
---

{
  limitedEntries.map((photo) => (
    <CarouselItem>
      {/* 2. Using Astro's native standard ID pattern instead of photo.url */}
      <a href={`/posts/${photo.id}`}>
        {/* 3. Using the correct schema property layout pointed out by the log (photo.data.img) */}
        <img src={photo.data.img?.src} alt={photo.data.img?.alt || photo.data.title} />
      </a>
    </CarouselItem>
  ))
}

<style>
  a {
    display: block;
    height: 220px;
    width: auto;
  }

  img {
    display: block;
    height: 100%;
    width: auto;
    object-fit: cover;
    background-color: var(--gray-3);
  }
</style>