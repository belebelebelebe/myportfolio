---
import { Image } from "astro:assets"; // 1. Import the Astro Image component
import { getCollection } from "astro:content";
import CarouselItem from "../CarouselItem.astro";

const LIMIT = 12;

const entries = await getCollection("posts");
const limitedEntries = entries.slice(0, LIMIT);
---

{
  limitedEntries.map((photo) => (
    <CarouselItem>
      <a href={`/posts/${photo.id}`}>
        {/* 2. Use <Image /> and pass the entire object to 'src' */}
        {photo.data.img ? (
          <Image src={photo.data.img} alt={photo.data.img.alt || photo.data.title} />
        ) : (
          <span>No image available</span>
        )}
      </a>
    </CarouselItem>
  ))
}

<style>
  a {
    display: block;
    height: 220px;
    width: auto;
  }
  /* Style the Astro component output or your layout as normal */
  a :global(img) { 
    display: block;
    height: 100%;
    width: auto;
    object-fit: cover;
    background-color: var(--gray-3);
  }
</style>